{
  "name": "geolibre-geoservice-plugin",
  "version": "0.3.9",
  "description": "GeoLibre plugin that browses an Open Geo Service STAC catalog and renders its published GeoZarr datasets.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/dhis2/geolibre-geoservice-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhis2/geolibre-geoservice-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/dhis2/open-geo-service/issues"
  },
  "keywords": [
    "geolibre",
    "geolibre-plugin",
    "open-geo-service",
    "stac",
    "zarr",
    "geozarr",
    "climate-data",
    "gis",
    "maplibre"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --config vite.geolibre.config.ts",
    "package:geolibre": "npm run build && node scripts/package-geolibre.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "chroma-js": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "archiver": "^7.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
